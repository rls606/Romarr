{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Restart Debug Environment",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/restart-docker.sh"
            ],
            "windows": {
                "command": "cmd.exe",
                "args": [
                    "/c",
                    "${workspaceFolder}\\restart-docker.bat"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}